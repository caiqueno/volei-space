{
  "name": "luva-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:organizer-flow && npm run test:team-sync && npm run test:registration-draft && npm run test:ponto-sumula && npm run test:championship-setup && npm run test:pricing && npm run test:categorias && npm run test:simulacao && npm run test:set-encerrado && npm run test:supabase-env && npm run test:category-replication && npm run test:category-selection && npm run test:category-setup-state && npm run test:postgres && npm run test:api",
    "test:e2e": "playwright test",
    "test:organizer-flow": "cross-env TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node scripts/organizer-flow.test.ts",
    "test:team-sync": "cross-env TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node scripts/team-registration-sync.test.ts",
    "test:registration-draft": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/team-registration-draft.test.ts",
    "test:ponto-sumula": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/ponto-sumula.test.ts",
    "test:championship-setup": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/championship-setup.test.ts",
    "test:pricing": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/pricing.test.ts",
    "test:categorias": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' node scripts/run-ts-tests.mjs category-match-rules.test.ts category-pricing.test.ts category-replication.test.ts",
    "test:simulacao": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/simulacao.test.ts",
    "test:set-encerrado": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/set-encerrado.test.ts",
    "test:supabase-env": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/supabase-env.test.ts",
    "test:category-replication": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/category-replication.test.ts",
    "test:category-selection": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' node scripts/run-if-category-db.mjs category-selection.test.ts",
    "test:category-setup-state": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' node scripts/run-if-category-db.mjs category-setup-state.test.ts",
    "test:postgres": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register scripts/postgres-servico.test.ts",
    "test:api": "cross-env TS_NODE_PROJECT=tsconfig.scripts.json TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true}' JWT_SECRET=teste-local-jwt-secret-32-chars-min NODE_ENV=development ts-node -r tsconfig-paths/register scripts/api-contrato.test.ts",
    "seed:simulacao": "set TS_NODE_PROJECT=tsconfig.scripts.json&& set TS_NODE_COMPILER_OPTIONS={\"module\":\"CommonJS\",\"esModuleInterop\":true}&& ts-node -r tsconfig-paths/register scripts/recriar-simulacao.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.106.2",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.18.2",
    "jose": "^5.9.6",
    "lucide-react": "^1.21.0",
    "next": "14.2.18",
    "nodemailer": "^9.1.1",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18",
    "slugify": "^1.6.9",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5"
  }
}
