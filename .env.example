# Supabase
# O app é Next.js: use estas variáveis, não VITE_SUPABASE_*.
# Local e preview: alvo desenvolvimento e o projeto caiqueno's Project.
# Produção (deploy da main): alvo producao e o projeto volei-space-producao.
# SUPABASE_SERVICE_ROLE_KEY fica só no servidor. Não use o prefixo NEXT_PUBLIC_.
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_ALVO="desenvolvimento"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_HOSTS_PROIBIDOS=""

# Auth
JWT_SECRET="troque-por-uma-string-segura-de-32-chars"
JWT_EXPIRES_IN="8h"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NODE_ENV="development"

# InfinitePay (https://developers.infinitepay.io)
# INFINITEPAY_WEBHOOK_SECRET é obrigatório. Sem ele, o webhook recusa a assinatura.
INFINITEPAY_API_KEY=""
INFINITEPAY_WEBHOOK_SECRET=""

# Confirmação manual de pagamento, sem gateway. Desligada por padrão.
# O administrador confirma mesmo com este valor ausente. O organizador só confirma com "true".
ALLOW_SIMULATED_PAYMENT_CONFIRMATION="false"

# E-mail (SMTP via Resend)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="re_sua_api_key_do_resend"
EMAIL_FROM="LUVA Liga <contato@seudominio.com.br>"
