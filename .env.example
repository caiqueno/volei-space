# volei.space — variáveis de ambiente
# Copie para .env no ambiente local. Na Vercel (mentel-solucoes/volei-space),
# cadastre cada chave em Settings → Environment Variables.
# Não commite valores reais. Este arquivo não contém segredo.
#
# NEXT_PUBLIC_* é embutida no JavaScript do navegador no momento do build.
# Mudou uma dessas chaves? Faça um novo deploy. Segredo nunca usa NEXT_PUBLIC_.
# Não defina NODE_ENV. A Vercel e o Next.js escolhem o valor. NODE_ENV=production
# no painel faz o npm pular devDependencies e o build quebra (Prisma e TypeScript).
#
# Produção (deploy da main): projeto Supabase volei-space-producao e
# NEXT_PUBLIC_SUPABASE_ALVO=producao.
# Preview e local: projeto de desenvolvimento e NEXT_PUBLIC_SUPABASE_ALVO=desenvolvimento.
# SUPABASE_HOSTS_PROIBIDOS lista hosts .supabase.co que aquele ambiente recusa.

# --- Postgres para o Prisma CLI (não é o caminho do app em runtime) ---
# O Next.js fala com o banco pela API do Supabase. Estas duas URLs existem
# porque prisma/schema.prisma declara url e directUrl.
#
# DATABASE_URL: pooler de transação do Supabase, porta 6543.
# Use no Prisma Client se ele passar a ser instanciado na Vercel.
# Parâmetros: pgbouncer=true e connection_limit=1.
# Não use esta URL para migration.
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: conexão direta (db.[ref].supabase.co:5432) ou pooler de sessão
# (pooler.supabase.com:5432). Sem pgbouncer=true. É a URL de `npm run db:migrate`.
DIRECT_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:5432/postgres"

# --- Supabase: runtime e build ---
# Obrigatórias em Production e Preview, com alvos diferentes.
# O build de /sitemap.xml consulta o banco quando estas três estão válidas.
# Sem SUPABASE_SERVICE_ROLE_KEY, esse build falha.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_ALVO="desenvolvimento"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_HOSTS_PROIBIDOS=""

# --- Auth (somente servidor, runtime) ---
# JWT_SECRET: string aleatória com pelo menos 32 caracteres.
JWT_SECRET="troque-por-uma-string-segura-de-32-chars"
JWT_EXPIRES_IN="8h"
# Obrigatório em produção e no preview da Vercel. Sem ele o login administrativo é recusado.
# No next dev local, se estiver vazio, a tabela Admin continua sendo a lista de acesso.
ADMIN_EMAIL=""

# --- App ---
# Build e runtime. Produção: a URL pública do site, com https.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional. Token do Google Search Console. Entra no HTML no build.
GOOGLE_SITE_VERIFICATION=""

# --- InfinitePay (servidor) ---
# INFINITEPAY_WEBHOOK_SECRET é obrigatório para o webhook. Sem ele, a assinatura é recusada.
INFINITEPAY_API_KEY=""
INFINITEPAY_WEBHOOK_SECRET=""

# Confirmação manual de pagamento, sem gateway. Desligada por padrão.
# O administrador confirma mesmo com este valor ausente. O organizador só confirma com "true".
ALLOW_SIMULATED_PAYMENT_CONFIRMATION="false"

# Cobrança da ativação do campeonato. Servidor, sem NEXT_PUBLIC_.
# Ausente, vazia ou com valor desconhecido, a produção não muda: o checkout
# simulado continua, a estrutura não responde 402 e pagamentoConfirmadoEm
# não é gravado. Na Vercel, para desligar a cobrança, defina
# PAGAMENTO_HABILITADO=false (também 0, nao, não, off ou no) e faça deploy.
# Só então a prévia deixa o pagamento e a estrutura libera o campeonato.
# Para exigir confirmação antes dos grupos, use true, 1, sim, yes ou on.
PAGAMENTO_HABILITADO="false"

# --- E-mail SMTP (opcional; servidor). Sem isso o app não envia e-mail. ---
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
EMAIL_FROM="volei.space <contato@seudominio.com.br>"

# --- Módulos das rodadas 9 a 12 (todos desligados por padrão; descomente só em desenvolvimento/preview) ---
# Flags de servidor (sem NEXT_PUBLIC_). A tela só aparece se a flag NEXT_PUBLIC_ correspondente também estiver ligada.
# BANCO_APP_ATIVO="true"             # liga as rotas do aplicativo do banco (papeleta, pedidos do banco)
# SCOUT_ATIVO="true"                 # liga o registro de scout de quadra (ScoutAcao)
# DESAFIO_ATIVO="true"               # liga o desafio por vídeo (DesafioVideo)
# DESAFIO_LIMITE_POR_SET="2"         # máximo de desafios por equipe em cada set (1 a 10)
# AO_VIVO_ATIVO="true"               # liga o placar ao vivo com eventos
# MEU_TIME_ATIVO="true"              # liga o Meu Time (fase 1: clube, time, atletas)
# MEU_TIME_FASE2_ATIVO="true"        # liga o Meu Time fase 2 (convites, importação, inscrição, notificações)
# SUMULA_EVENTOS_ATIVO="true"        # liga a gravação de eventos da súmula (append-only)
# SUMULA_SERVIDOR_SOMBRA="1"         # modo sombra: o servidor só informa divergências da súmula, nunca bloqueia
# Chave de cifra de dados pessoais (CPF, telefone, contato do convite): 32 bytes em base64.
# SERVIDOR APENAS, nunca NEXT_PUBLIC_. Sem chave válida as rotas recusam gravar. Gere uma por ambiente.
# LGPD_CHAVE_CIFRA=""
# Flags de tela (embutidas no navegador no build; mudou, faça novo deploy):
# NEXT_PUBLIC_BANCO_APP_ATIVO="true"        # mostra as telas do aplicativo do banco
# NEXT_PUBLIC_SCOUT_ATIVO="true"            # mostra a tela de scout
# NEXT_PUBLIC_DESAFIO_ATIVO="true"          # mostra o botão e a tela de desafio por vídeo
# NEXT_PUBLIC_AO_VIVO_ATIVO="true"          # mostra o placar ao vivo com eventos
# NEXT_PUBLIC_MEU_TIME_FASE2_ATIVO="true"   # mostra convites, importação e notificações do Meu Time
# NEXT_PUBLIC_SUMULA_EVENTOS_ATIVO="true"   # a súmula do cliente passa a enviar eventos
# NEXT_PUBLIC_PROTOTIPO_ATIVO="true"        # mostra as páginas de protótipo (só desenvolvimento)
