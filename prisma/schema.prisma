  woSetsVencedor                  Int?
  woSetsPerdedor                  Int?
  woPontosSetVencedor             Int?
  woPontosSetPerdedor             Int?
  woPunicaoPontos                 Int?      @default(0)
  genero                          String?
  idadeMinima                     Int?
  idadeMaxima                     Int?
  pontuacaoResultado              Json?
  pontosVencedorMargem1           Int       @default(2)
  pontosPerdedorMargem1           Int       @default(1)
  pontosVencedorMargem2           Int       @default(3)
  pontosPerdedorMargem2           Int       @default(0)
  classificadosPorGrupo           Int       @default(0)
  melhoresClassificadosGerais     Int       @default(0)
  nomesGrupos                     String?
  faseEliminatoria                String    @default("NENHUMA")
  metodoChaveamento               String    @default("MANUAL")
