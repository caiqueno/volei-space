model CodigoAcessoOrganizador {
  id            String    @id @default(uuid()) @db.Uuid
  codigo        String    @unique
  organizadorId String?   @unique
  criadoEm      DateTime  @default(now())
  usadoEm       DateTime?
}

model ContaPublico {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  status    String   @default("ATIVA")
  criadoEm  DateTime @default(now())
}

model CategoriaCampeonato {
  id                 String    @id @default(uuid()) @db.Uuid
  ligaId             Int
  codigo             String
  nome               String
  slug               String
  ordem              Int       @default(0)
  tokenInscricao     String?
  statusConfiguracao String    @default("NAO_INICIADA")
  versao             Int       @default(1)
  revisaoOperacional Int       @default(0)
  removidaEm         DateTime?
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @default(now())

  convitesVaga ConviteVagaEquipe[]

  @@unique([ligaId, codigo])
  @@unique([ligaId, slug])
  @@index([ligaId, ordem])
}

model ConviteVagaEquipe {
  id                    String   @id @default(uuid()) @db.Uuid
  ligaId                Int
  categoriaCampeonatoId String   @db.Uuid
  vaga                  Int
  token                 String   @unique
  equipeId              Int?
  inscricaoRascunhoId   String?  @unique @db.Uuid
  status                String   @default("DISPONIVEL")
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  liga      Liga                     @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  categoria CategoriaCampeonato      @relation(fields: [categoriaCampeonatoId], references: [id], onDelete: Cascade)
  equipe    Equipe?                  @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  rascunho  InscricaoEquipeRascunho? @relation(fields: [inscricaoRascunhoId], references: [id], onDelete: SetNull)

  @@unique([ligaId, categoriaCampeonatoId, vaga])
  @@index([ligaId])
  @@index([categoriaCampeonatoId])
  @@index([status])
  @@index([equipeId])
}

model CategoriaConfiguracao {
