model GrupoCampeonato {
  id                    BigInt   @id @default(autoincrement())
  ligaId                Int
  categoriaCampeonatoId String   @db.Uuid
  nome                  String
  ordem                 Int      @default(1)
  classificados         Int      @default(0)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @default(now())

  liga     Liga                    @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  equipes  GrupoEquipeCampeonato[]
  partidas Partida[]

  @@unique([categoriaCampeonatoId, nome])
  @@index([ligaId, ordem])
}

model GrupoEquipeCampeonato {
  id                    BigInt   @id @default(autoincrement())
  grupoId               BigInt
  ligaId                Int
  categoriaCampeonatoId String   @db.Uuid
  equipeId              Int
  posicao               Int      @default(1)
  criadoEm              DateTime @default(now())

  grupo  GrupoCampeonato @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  liga   Liga            @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  equipe Equipe          @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@unique([ligaId, equipeId])
  @@unique([grupoId, equipeId])
  @@index([equipeId])
}

model LigaLocal {
