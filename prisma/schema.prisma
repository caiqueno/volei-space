// Fonte da verdade do banco: supabase/migrations, na ordem do prefixo
// numérico. Este arquivo descreve esse banco. Não existe prisma/migrations;
// não use `prisma migrate` nem `prisma db push` para alterar o Postgres.
// Índices parciais (seedKey, tokenInscricao, vitrine com simulacao = false)
// ficam só no SQL: o Prisma não expressa a cláusula WHERE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Liga ─────────────────────────────────────────────────────────────────────

model Liga {
  id                              Int       @id @default(autoincrement())
  slug                            String    @unique
  nome                            String
  subtitulo                       String?
  descricao                       String?
  regulamento                     String?
  premiacao                       String?
  nomeCurto                       String?
  quantidadeEquipes               Int?
  quantidadeEquipesMinima         Int?
  quantidadeEquipesMaxima         Int?
  formato                         String?
  quantidadeGrupos                Int?
  nomesGrupos                     String?
  faseEliminatoria                String?   @default("NENHUMA")
  turnoReturno                    Boolean   @default(false)
  setsFormato                     String    @default("MELHOR_DE")
  setsPorPartida                  Int       @default(3)
  setsPorPartidaFinal             Int?
  setsPorPartidaSemifinal         Int?
  setsPorPartidaQuartas           Int?
  setsPorPartidaOitavas           Int?
  setsPorPartidaTerceiroLugar     Int?
  pontosPorSet                    Int       @default(25)
  diferencaMinimaSet              Int       @default(2)
  tieBreakUltimoSet               Boolean   @default(false)
  pontosUltimoSet                 Int?
  criteriosClassificacao          String?
  woSetsVencedor                  Int?
  woSetsPerdedor                  Int?
  woPontosSetVencedor             Int?
  woPontosSetPerdedor             Int?
  woPunicaoPontos                 Int?      @default(0)
  pontuacaoResultado              Json?
  classificadosPorGrupo           Int?
  melhoresClassificadosGerais     Int       @default(0)
  metodoChaveamento               String    @default("MANUAL")
  eliminatoriaIdaVolta            Boolean   @default(false)
  disputaTerceiroLugar            Boolean   @default(true)
  goldenSet                       Boolean   @default(false)
  inscricoesAbertas               Boolean   @default(true)
  inscricoesAberturaEm            DateTime?
  inscricoesEncerramentoEm        DateTime?
  inscricaoAprovacaoAutomatica    Boolean   @default(false)
  inscricaoPermiteEdicaoAposEnvio Boolean   @default(true)
  inscricaoPrazoEdicaoDias        Int?
  elencoQuantidadeMinima          Int?
  elencoQuantidadeMaxima          Int?
  elencoCadastroDuranteInscricao  Boolean   @default(true)
  elencoCadastroAposAprovacao     Boolean   @default(true)
  prazoAlteracaoElencoDias        Int?
  qrCodeEnabled                   Boolean   @default(false)
  sumulaScoutsEnabled             Boolean   @default(false)
  formularioInscricaoConfig       Json?
  categoriasConfig                String?
  logoUrl                         String?
  capaUrl                         String?
  corTematica                     String    @default("#0F2C52")
  status                          String    @default("EM_BREVE") // EM_BREVE | ATIVA | ENCERRADA | FINALIZADO
  simulacao                       Boolean   @default(false)
  simulacaoRelogio                Json      @default("{}")
  finalizadoEm                    DateTime?
  finalizadoPor                   String?
  organizadorId                   String?
  pagamentoConfirmadoEm           DateTime?
  dataInicio                      DateTime?
  dataFim                         DateTime?
  criadoEm                        DateTime  @default(now())
  atualizadoEm                    DateTime  @default(now()) @updatedAt

  equipes                    Equipe[]
  partidas                   Partida[]
  classificacoesEliminatoria ClassificacaoEliminatoria[]
  premiacoes                 Premiacao[]
  galeria                    Midia[]
  mensagens                  Mensagem[]
  candidaturasEquipe         CandidaturaEquipe[]
  candidaturasQuadra         CandidaturaQuadra[]
  inscricoes                 InscricaoCampeonato[]
  convitesEquipe             ConviteEquipe[]
  inscricoesRascunho         InscricaoEquipeRascunho[]
  convitesVaga               ConviteVagaEquipe[]
  classificacaoEntradas      ClassificacaoEntrada[]
  grupos                     GrupoCampeonato[]
  gruposEquipe               GrupoEquipeCampeonato[]
  locais                     LigaLocal[]
  setupSecoes                LigaSetupSecao[]
  linkInscricao              LinkInscricaoCampeonato?
  linksInscricaoEvento       LinkInscricaoEvento[]

  seedKey String?

  @@index([organizadorId])
  @@index([organizadorId, criadoEm])
}

// ─── Equipe ───────────────────────────────────────────────────────────────────

model Equipe {
  id                    Int      @id @default(autoincrement())
  nome                  String
  logoUrl               String?
  lider                 String?
  tecnico               String?
  corHex                String?
  categoria             String // FEMININO | FEMININO_MASTER | MISTO | MASCULINO | MASCULINO_MASTER
  serie                 String? // legado; a migration de categoria tirou o NOT NULL e o default
  categoriaCampeonatoId String   @db.Uuid
  seedKey               String?
  ligaId                Int
  liga                  Liga     @relation(fields: [ligaId], references: [id])
  // ── campos de inscrição ──
  slug                  String?  @unique
  statusEquipe          String   @default("ATIVA") // PENDENTE | ATIVA | INATIVA
  inscricaoAtiva        Boolean  @default(true)
  diasDisponiveis       String? // JSON array
  horarios              String? // JSON object
  quadraInfo            String? // JSON object
  criadoEm              DateTime @default(now())

  jogadores                  Jogador[]
  partidasComoA              Partida[]                   @relation("EquipeA")
  partidasComoB              Partida[]                   @relation("EquipeB")
  sumulaPresencas            SumulaPresenca[]
  classificacaoEntradas      ClassificacaoEntrada[]
  classificacoesEliminatoria ClassificacaoEliminatoria[]
  grupos                     GrupoEquipeCampeonato[]
  candidatura                CandidaturaEquipe?
  inscricoes                 InscricaoCampeonato[]
  inscricoesRascunho         InscricaoEquipeRascunho[]
  convitesVaga               ConviteVagaEquipe[]

  @@unique([nome, ligaId, categoria, serie])
  @@unique([categoriaCampeonatoId, nome])
  @@index([ligaId])
  @@index([ligaId, statusEquipe, nome])
}

model InscricaoCampeonato {
  id                    String   @id @default(cuid())
  ligaId                Int
  categoriaCampeonatoId String   @db.Uuid
  equipeId              Int
  status                String   @default("SOLICITADA") // SOLICITADA | APROVADA | REJEITADA
  observacao            String?
  criadaEm              DateTime @default(now())
  atualizadaEm          DateTime @updatedAt

  liga     Liga                     @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  equipe   Equipe                   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  rascunho InscricaoEquipeRascunho?

  @@unique([ligaId, equipeId])
  @@index([equipeId])
}

model InscricaoEquipeRascunho {
  id                    String    @id @default(uuid()) @db.Uuid
  token                 String    @unique @default(uuid()) @db.Uuid
  ligaId                Int
  nomeEquipe            String?
  logoUrl               String?
  lider                 String?
  tecnico               String?
  categoria             String?
  serie                 String?
  categoriaCampeonatoId String    @db.Uuid
  status                String    @default("NAO_INICIADO")
  equipeId              Int?      @unique
  inscricaoCampeonatoId String?   @unique
  criadaEm              DateTime  @default(now())
  atualizadaEm          DateTime  @updatedAt
  enviadaEm             DateTime?

  liga                Liga                             @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  equipe              Equipe?                          @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  inscricaoCampeonato InscricaoCampeonato?             @relation(fields: [inscricaoCampeonatoId], references: [id], onDelete: SetNull)
  jogadores           InscricaoEquipeJogadorRascunho[]
  conviteVaga         ConviteVagaEquipe?

  @@index([ligaId, status])
}

model InscricaoEquipeJogadorRascunho {
  id                  String    @id @default(uuid()) @db.Uuid
  inscricaoRascunhoId String    @db.Uuid
  jogadorId           Int?      @unique
  nome                String
  numero              Int?
  posicao             String?
  fotoUrl             String?
  cpf                 String?
  dataNascimento      DateTime?
  documentoTipo       String?
  documentoNumero     String?
  sexo                String?
  chaveCadastro       String?   @db.Uuid
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  inscricaoRascunho InscricaoEquipeRascunho @relation(fields: [inscricaoRascunhoId], references: [id], onDelete: Cascade)
  jogador           Jogador?                @relation(fields: [jogadorId], references: [id], onDelete: SetNull)

  @@unique([inscricaoRascunhoId, chaveCadastro])
  @@index([inscricaoRascunhoId, criadoEm])
}

model ConviteEquipe {
  id                  String    @id @default(uuid()) @db.Uuid
  token               String    @unique @db.Uuid
  ligaId              Int
  organizadorId       String
  email               String
  nomeEquipe          String?
  mensagem            String?
  status              String    @default("ENVIADO")
  candidaturaEquipeId String?
  aceitoEm            DateTime?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  liga              Liga               @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  candidaturaEquipe CandidaturaEquipe? @relation(fields: [candidaturaEquipeId], references: [id], onDelete: SetNull)

  @@index([ligaId])
  @@index([organizadorId])
  @@index([email])
  @@index([candidaturaEquipeId])
}

// ─── Jogador ──────────────────────────────────────────────────────────────────

model Jogador {
  id                 Int       @id @default(autoincrement())
  nome               String
  fotoUrl            String?
  posicao            String?
  numero             Int?
  equipeId           Int
  equipe             Equipe    @relation(fields: [equipeId], references: [id])
  chaveCadastro      String?   @db.Uuid
  seedKey            String?
  // ── campos de auto-cadastro ──
  cpf                String?
  documentoTipo      String?
  documentoNumero    String?
  dataNascimento     DateTime?
  sexo               String?
  telefone           String?
  telefoneEmergencia String?
  fotoRostoUrl       String?
  documentosUrls     String?
  qrCodeToken        String?   @unique
  qrCodeGeradoEm     DateTime?
  autoRegistrado     Boolean   @default(false)
  banido             Boolean   @default(false)
  criadoEm           DateTime  @default(now())

  presencas         SumulaPresenca[]
  destaquePartidas  DestaquesPartida[]
  votosRecebidos    VotoMVP[]
  ocorrencias       OcorrenciaPartida[]
  inscricaoRascunho InscricaoEquipeJogadorRascunho?

  @@unique([equipeId, chaveCadastro])
  @@index([equipeId])
  @@index([equipeId, numero, nome])
  @@index([equipeId, banido, criadoEm])
}

// ─── Árbitro ──────────────────────────────────────────────────────────────────

model Arbitro {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  telefone   String?
  cref       String?
  diplomaUrl String?
  aprovado   Boolean  @default(false)
  criadoEm   DateTime @default(now())

  partidas           EscalaArbitro[]
  candidaturaArbitro CandidaturaArbitro?
}

model CandidaturaPartidaArbitro {
  id                   String    @id @default(cuid())
  partidaId            Int
  candidaturaArbitroId String
  status               String    @default("SOLICITADA")
  criadoEm             DateTime  @default(now())
  decididoEm           DateTime?

  partida     Partida            @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  candidatura CandidaturaArbitro @relation(fields: [candidaturaArbitroId], references: [id], onDelete: Cascade)

  @@unique([partidaId, candidaturaArbitroId])
  @@index([partidaId, status])
  @@index([candidaturaArbitroId, status])
}

model EscalaArbitro {
  id        Int     @id @default(autoincrement())
  partidaId Int
  arbitroId Int
  cargo     String // PRIMEIRO_ARBITRO | SEGUNDO_ARBITRO
  partida   Partida @relation(fields: [partidaId], references: [id])
  arbitro   Arbitro @relation(fields: [arbitroId], references: [id])

  @@unique([partidaId, cargo])
  @@index([arbitroId])
}

// ─── Partida ──────────────────────────────────────────────────────────────────

model Partida {
  id                    Int              @id @default(autoincrement())
  ligaId                Int
  liga                  Liga             @relation(fields: [ligaId], references: [id])
  equipeAId             Int?
  equipeBId             Int?
  equipeA               Equipe?          @relation("EquipeA", fields: [equipeAId], references: [id])
  equipeB               Equipe?          @relation("EquipeB", fields: [equipeBId], references: [id])
  origemVagaA           String?
  origemVagaB           String?
  categoria             String
  serie                 String?
  categoriaCampeonatoId String           @db.Uuid
  grupoId               BigInt?
  grupo                 GrupoCampeonato? @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  fase                  String           @default("GERAL")
  seedKey               String?
  rodada                Int
  status                String           @default("AGENDADA")
  dataHora              DateTime?
  localNome             String?
  localEndereco         String?

  setsPorA   Int?
  setsPorB   Int?
  pontosPorA Int?
  pontosPorB Int?
  vencedorId Int?

  sumulaToken       String?   @unique
  sumulaTokenExpira DateTime?
  sumulaSubmetidaEm DateTime?
  sumulaAprovadaEm  DateTime?

  sets                SetPartida[]
  escala              EscalaArbitro[]
  candidaturasArbitro CandidaturaPartidaArbitro[]
  destaques           DestaquesPartida[]
  presencas           SumulaPresenca[]
  ocorrencias         OcorrenciaPartida[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  acessosArbitro       AcessoArbitroJogo?
  acessosArbitroEvento AcessoArbitroEvento[]

  @@index([ligaId, categoria, serie, rodada])
  @@index([equipeAId])
  @@index([equipeBId])
  @@index([grupoId])
  @@index([ligaId, fase, rodada])
  @@index([ligaId, status, dataHora])
  @@index([status, dataHora])
  @@index([ligaId, rodada, dataHora])
}

// ─── Sets da Partida ──────────────────────────────────────────────────────────

model SetPartida {
  id        Int     @id @default(autoincrement())
  partidaId Int
  numero    Int
  pontosA   Int
  pontosB   Int
  partida   Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)

  @@unique([partidaId, numero])
}

// ─── Súmula — Presenças ───────────────────────────────────────────────────────

model SumulaPresenca {
  id        Int     @id @default(autoincrement())
  partidaId Int
  jogadorId Int
  equipeId  Int
  presente  Boolean? @default(true) // nulo = presença ainda não decidida; a linha pode existir só pelo número
  numero    Int? // número de camisa desta partida; nulo usa o cadastro do atleta
  partida   Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  jogador   Jogador @relation(fields: [jogadorId], references: [id])
  equipe    Equipe  @relation(fields: [equipeId], references: [id])

  @@unique([partidaId, jogadorId])
  @@index([jogadorId])
  @@index([equipeId])
}

// ─── Súmula — Ocorrências ────────────────────────────────────────────────────

model OcorrenciaPartida {
  id        Int      @id @default(autoincrement())
  partidaId Int
  tipo      String // CARTAO_AMARELO | CARTAO_VERMELHO | WO | OBSERVACAO
  descricao String?
  set       Int?
  jogadorId Int? // atleta responsável pelo scout (ponto/ataque/bloqueio/ace), quando aplicável
  partida   Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  jogador   Jogador? @relation(fields: [jogadorId], references: [id])

  @@index([partidaId])
  @@index([jogadorId])
  @@index([partidaId, set])
  @@index([partidaId, tipo])
}

// ─── Destaques por Partida ────────────────────────────────────────────────────

model DestaquesPartida {
  id        Int     @id @default(autoincrement())
  partidaId Int
  jogadorId Int
  tipo      String // MVP | MELHOR_SAQUE | MELHOR_BLOQUEIO
  partida   Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  jogador   Jogador @relation(fields: [jogadorId], references: [id])

  @@unique([partidaId, tipo])
  @@index([jogadorId])
}

// ─── Votação MVP ─────────────────────────────────────────────────────────────

model VotoMVP {
  id                    Int      @id @default(autoincrement())
  jogadorId             Int
  ligaId                Int
  categoriaCampeonatoId String   @db.Uuid
  categoria             String
  serie                 String?
  sessaoId              String
  criadoEm              DateTime @default(now())
  jogador               Jogador  @relation(fields: [jogadorId], references: [id])

  @@unique([jogadorId, sessaoId])
}

// ─── Classificação (cache calculado) ─────────────────────────────────────────

model ClassificacaoEntrada {
  id                    Int      @id @default(autoincrement())
  equipeId              Int
  equipe                Equipe   @relation(fields: [equipeId], references: [id])
  ligaId                Int
  liga                  Liga     @relation(fields: [ligaId], references: [id])
  categoriaCampeonatoId String   @db.Uuid
  categoria             String
  serie                 String?
  posicao               Int
  pontos                Int      @default(0)
  jogos                 Int      @default(0)
  vitorias              Int      @default(0)
  derrotas              Int      @default(0)
  setsPro               Int      @default(0)
  setsContra            Int      @default(0)
  pontosPro             Int      @default(0)
  pontosContra          Int      @default(0)
  punicoes              Int      @default(0)
  atualizadoEm          DateTime @default(now()) @updatedAt

  @@unique([ligaId, equipeId])
  @@index([ligaId])
  @@index([equipeId])
}

model ClassificacaoEliminatoria {
  id                    Int      @id @default(autoincrement())
  ligaId                Int
  categoriaCampeonatoId String   @db.Uuid
  equipeId              Int
  organizadorId         String
  origem                String   @default("MANUAL")
  criadoEm              DateTime @default(now())

  liga   Liga   @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  equipe Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@unique([ligaId, equipeId])
  @@index([ligaId])
  @@index([equipeId])
  @@index([organizadorId])
}

// ─── Premiação ────────────────────────────────────────────────────────────────

model Premiacao {
  id                    Int     @id @default(autoincrement())
  ligaId                Int
  liga                  Liga    @relation(fields: [ligaId], references: [id])
  categoria             String
  serie                 String?
  categoriaCampeonatoId String  @db.Uuid
  colocacao             Int
  descricao             String
  imagemUrl             String?

  @@index([ligaId])
}

// ─── Galeria ──────────────────────────────────────────────────────────────────

model Midia {
  id       Int      @id @default(autoincrement())
  ligaId   Int
  liga     Liga     @relation(fields: [ligaId], references: [id])
  tipo     String // FOTO | VIDEO
  url      String
  thumbUrl String?
  titulo   String?
  tag      String? // DESTAQUE | RODADA | PREMIACAO
  criadoEm DateTime @default(now())

  @@index([ligaId])
}

// ─── Mural de Mensagens ───────────────────────────────────────────────────────

model Mensagem {
  id       Int      @id @default(autoincrement())
  ligaId   Int
  liga     Liga     @relation(fields: [ligaId], references: [id])
  autor    String
  texto    String
  aprovada Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@index([ligaId])
}

// ─── Usuário Admin ───────────────────────────────────────────────────────────

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senhaHash String
  nome      String
  criadoEm  DateTime @default(now())
}

// ─── Candidaturas (novo) ─────────────────────────────────────────────────────

model CandidaturaEquipe {
  id                    String          @id @default(cuid())
  nome                  String
  responsavel           String
  email                 String
  telefone              String?
  senhaHash             String?
  categoria             String
  serie                 String?
  categoriaCampeonatoId String          @db.Uuid
  genero                String?
  categoriaEtaria       String?
  nivel                 String?
  possuiLocalTreino     Boolean         @default(false)
  horariosTreino        Json?
  cederQuadra           Boolean         @default(false)
  temInstagram          Boolean         @default(false)
  instagram             String?
  diasDisponiveis       String // JSON array
  horarios              String // JSON object
  quadraInfo            String // JSON object
  ligaId                Int
  liga                  Liga            @relation(fields: [ligaId], references: [id])
  status                String          @default("PENDENTE") // PENDENTE | APROVADA | REJEITADA | ATIVA
  pagamentoId           String?         @unique
  pagamento             Pagamento?      @relation(fields: [pagamentoId], references: [id])
  equipeId              Int?            @unique
  equipe                Equipe?         @relation(fields: [equipeId], references: [id])
  convites              ConviteEquipe[]
  criadaEm              DateTime        @default(now())
  atualizadaEm          DateTime        @updatedAt

  @@index([ligaId])
}

model CandidaturaArbitro {
  id                   String                      @id @default(cuid())
  nome                 String
  email                String                      @unique
  telefone             String?
  senhaHash            String?
  cref                 String?
  diplomaUrl           String?
  status               String                      @default("PENDENTE") // PENDENTE | APROVADA | REJEITADA | ATIVA
  organizadorId        String?
  trocarSenha          Boolean                     @default(false)
  arbitroId            Int?                        @unique
  arbitro              Arbitro?                    @relation(fields: [arbitroId], references: [id])
  partidasCandidatadas CandidaturaPartidaArbitro[]
  criadaEm             DateTime                    @default(now())
  atualizadaEm         DateTime                    @updatedAt

  @@index([organizadorId])
}

model CandidaturaQuadra {
  id             String   @id @default(cuid())
  nome           String
  responsavel    String
  email          String
  telefone       String?
  senhaHash      String?
  cep            String?
  endereco       String
  bairro         String?
  estrutura      String?
  horarios       String?
  fotosUrls      String?
  cobertura      Boolean  @default(false)
  banheiro       Boolean  @default(false)
  estacionamento Boolean  @default(false)
  ligaId         Int?
  liga           Liga?    @relation(fields: [ligaId], references: [id])
  status         String   @default("PENDENTE")
  criadaEm       DateTime @default(now())
  atualizadaEm   DateTime @updatedAt

  @@index([ligaId])
  @@index([status])
}

model CandidaturaOrganizador {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  telefone          String?
  senhaHash         String?
  organizacao       String?
  cidade            String?
  logoUrl           String?
  plano             String    @default("PRO")
  status            String    @default("ATIVA")
  trocarSenha       Boolean   @default(false)
  emailVerificadoEm DateTime?
  criadaEm          DateTime  @default(now())
  atualizadaEm      DateTime  @updatedAt
}

model Pagamento {
  id                String             @id @default(cuid())
  infinitePayId     String?            @unique
  linkCobranca      String?
  status            String             @default("AGUARDANDO") // AGUARDANDO | PAGO | CANCELADO | EXPIRADO
  valor             Float
  descricao         String
  webhookPayload    String?
  pagoEm            DateTime?
  criadoEm          DateTime           @default(now())
  candidaturaEquipe CandidaturaEquipe?
}

// ─── Interessados (captação landing) ─────────────────────────────────────────

model Interessado {
  id           String   @id @default(uuid()) @db.Uuid
  nomeCompleto String
  email        String   @unique
  whatsapp     String
  cidade       String
